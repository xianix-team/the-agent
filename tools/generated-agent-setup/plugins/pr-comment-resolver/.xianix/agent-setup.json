{
  "schemaVersion": 1,
  "plugin": "pr-comment-resolver",
  "slashCommand": "/resolve-comments",
  "platforms": {
    "azuredevops": {
      "requiredEnvs": [
        "AZURE-DEVOPS-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedTriggers": [
        "PR tag ai-dlc/pr/resolve-comments"
      ],
      "executions": [
        {
          "name": "azuredevops-pr-comment-resolver",
          "platform": "azuredevops",
          "repository": {
            "url": {
              "value": "https://dev.azure.com/org/project/_git/repo",
              "constant": true
            }
          },
          "match-any": [
            {
              "name": "azuredevops-pr-comment-resolver-tag",
              "rule": "eventType==git.pullrequest.created&&resource.labels.*.name=='ai-dlc/pr/resolve-comments'&&resource.status=='active'"
            },
            {
              "name": "azuredevops-pr-comment-resolver-updated-tag",
              "rule": "eventType==git.pullrequest.updated&&resource.labels.*.name=='ai-dlc/pr/resolve-comments'&&resource.status=='active'"
            }
          ],
          "use-inputs": [
            {
              "name": "pr-number",
              "value": "resource.pullRequestId",
              "mandatory": true
            }
          ],
          "use-plugins": [
            {
              "plugin-name": "pr-comment-resolver@xianix-plugins-official",
              "marketplace": "xianix-team/plugins-official",
              "slash-command": "/resolve-comments"
            }
          ],
          "with-envs": [
            {
              "name": "AZURE-DEVOPS-TOKEN",
              "value": "secrets.AZURE-DEVOPS-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "model": "claude-sonnet-4-5",
          "max-budget-usd": 5.0,
          "execute-prompt": "Pull request #{{pr-number}} requested comment resolution. Run /resolve-comments {{pr-number}}."
        }
      ]
    },
    "github": {
      "requiredEnvs": [
        "GITHUB-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedGitHubWebhookEvents": [
        "pull_request_review_comment",
        "issue_comment"
      ],
      "suggestedTriggers": [
        "PR label ai-dlc/pr/resolve-comments"
      ],
      "executions": [
        {
          "name": "github-pr-comment-resolver",
          "platform": "github",
          "repository": {
            "url": {
              "value": "https://github.com/org/repo.git",
              "constant": true
            }
          },
          "match-any": [
            {
              "name": "github-pr-comment-resolver-tag-applied",
              "rule": "action==labeled&&label.name=='ai-dlc/pr/resolve-comments'&&pull_request.state=='open'"
            },
            {
              "name": "github-pr-comment-resolver-opened-with-tag",
              "rule": "action==opened&&pull_request.labels.*.name=='ai-dlc/pr/resolve-comments'&&pull_request.state=='open'"
            },
            {
              "name": "github-pr-comment-resolver-synchronize-with-tag",
              "rule": "action==synchronize&&pull_request.labels.*.name=='ai-dlc/pr/resolve-comments'&&pull_request.state=='open'"
            }
          ],
          "use-inputs": [
            {
              "name": "pr-number",
              "value": "pull_request.number",
              "mandatory": true
            }
          ],
          "use-plugins": [
            {
              "plugin-name": "pr-comment-resolver@xianix-plugins-official",
              "marketplace": "xianix-team/plugins-official",
              "slash-command": "/resolve-comments"
            }
          ],
          "with-envs": [
            {
              "name": "GITHUB-TOKEN",
              "value": "secrets.GITHUB-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "model": "claude-sonnet-4-5",
          "max-budget-usd": 5.0,
          "execute-prompt": "Pull request #{{pr-number}} requested comment resolution. Run /resolve-comments {{pr-number}}."
        }
      ]
    }
  },
  "chat": {
    "slashCommand": "/resolve-comments",
    "model": "claude-sonnet-4-5",
    "max-budget-usd": 5.0
  }
}
