{
  "schemaVersion": 1,
  "plugin": "release-note-maintainer",
  "slashCommand": "/release-notes",
  "platforms": {
    "azuredevops": {
      "requiredEnvs": [
        "AZURE-DEVOPS-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedTriggers": [
        "Git tag push"
      ],
      "executions": [
        {
          "name": "azuredevops-release-note-maintainer",
          "platform": "azuredevops",
          "repository": {
            "url": {
              "value": "https://dev.azure.com/org/project/_git/repo",
              "constant": true
            }
          },
          "match-any": [
            {
              "name": "azuredevops-release-note-maintainer-tag",
              "rule": "eventType==git.push&&resource.refUpdates.*.name*='refs/tags/'"
            }
          ],
          "use-plugins": [
            {
              "plugin-name": "release-note-maintainer@xianix-plugins-official",
              "marketplace": "xianix-team/plugins-official",
              "slash-command": "/release-notes"
            }
          ],
          "with-envs": [
            {
              "name": "AZURE-DEVOPS-TOKEN",
              "value": "secrets.AZURE-DEVOPS-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "model": "claude-sonnet-4-5",
          "max-budget-usd": 5.0,
          "execute-prompt": "A new git tag was published. Run /release-notes to generate structured release notes."
        }
      ]
    },
    "github": {
      "requiredEnvs": [
        "GITHUB-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedGitHubWebhookEvents": [
        "create",
        "release",
        "push"
      ],
      "suggestedTriggers": [
        "Git tag created / release published"
      ],
      "executions": [
        {
          "name": "github-release-note-maintainer",
          "platform": "github",
          "repository": {
            "url": {
              "value": "https://github.com/org/repo.git",
              "constant": true
            }
          },
          "match-any": [
            {
              "name": "github-release-note-maintainer-tag",
              "rule": "ref_type=='tag'"
            }
          ],
          "use-plugins": [
            {
              "plugin-name": "release-note-maintainer@xianix-plugins-official",
              "marketplace": "xianix-team/plugins-official",
              "slash-command": "/release-notes"
            }
          ],
          "with-envs": [
            {
              "name": "GITHUB-TOKEN",
              "value": "secrets.GITHUB-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "model": "claude-sonnet-4-5",
          "max-budget-usd": 5.0,
          "execute-prompt": "A new git tag was published. Run /release-notes to generate structured release notes."
        }
      ]
    }
  },
  "chat": {
    "slashCommand": "/release-notes",
    "model": "claude-sonnet-4-5",
    "max-budget-usd": 5.0
  }
}
