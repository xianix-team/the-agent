{
  "schemaVersion": 1,
  "plugin": "dependency-optimizer",
  "slashCommand": "/dependency-optimizer",
  "platforms": {
    "azuredevops": {
      "requiredEnvs": [
        "AZURE-DEVOPS-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedTriggers": [
        "Schedule cron (default 15 0 1,15 * *)"
      ],
      "notes": "Uses a schedule execution block inside the webhook rule set (not a label trigger).",
      "executions": [
        {
          "schedule": "azuredevops-dependency-optimizer-schedule",
          "platform": "azuredevops",
          "cron": "15 0 1,15 * *",
          "with-envs": [
            {
              "name": "AZURE-DEVOPS-TOKEN",
              "value": "secrets.AZURE-DEVOPS-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "executions": [
            {
              "name": "azuredevops-dependency-optimizer",
              "platform": "azuredevops",
              "repository": {
                "url": {
                  "value": "https://dev.azure.com/org/project/_git/repo",
                  "constant": true
                }
              },
              "use-plugins": [
                {
                  "plugin-name": "dependency-optimizer@xianix-plugins-official",
                  "marketplace": "xianix-team/plugins-official"
                }
              ],
              "model": "claude-sonnet-4-5",
              "max-budget-usd": 10.0,
              "execute-prompt": "You are xianix-agent assigned for dependency health optimization. Run /dependency-optimizer to scan manifests, verify licenses, and open a remediation pull request when safe."
            }
          ]
        }
      ]
    },
    "github": {
      "requiredEnvs": [
        "GITHUB-TOKEN",
        "ANTHROPIC-API-KEY"
      ],
      "suggestedTriggers": [
        "Schedule cron (default 15 0 1,15 * *)"
      ],
      "notes": "Uses a schedule execution block inside the webhook rule set (not a label trigger).",
      "executions": [
        {
          "schedule": "github-dependency-optimizer-schedule",
          "platform": "github",
          "cron": "15 0 1,15 * *",
          "with-envs": [
            {
              "name": "GITHUB-TOKEN",
              "value": "secrets.GITHUB-TOKEN",
              "mandatory": true
            },
            {
              "name": "ANTHROPIC-API-KEY",
              "value": "secrets.ANTHROPIC-API-KEY",
              "mandatory": true
            }
          ],
          "executions": [
            {
              "name": "github-dependency-optimizer",
              "platform": "github",
              "repository": {
                "url": {
                  "value": "https://github.com/org/repo.git",
                  "constant": true
                }
              },
              "use-plugins": [
                {
                  "plugin-name": "dependency-optimizer@xianix-plugins-official",
                  "marketplace": "xianix-team/plugins-official"
                }
              ],
              "model": "claude-sonnet-4-5",
              "max-budget-usd": 10.0,
              "execute-prompt": "You are xianix-agent assigned for dependency health optimization. Run /dependency-optimizer to scan manifests, verify licenses, and open a remediation pull request when safe."
            }
          ]
        }
      ]
    }
  },
  "chat": {
    "slashCommand": "/dependency-optimizer",
    "model": "claude-sonnet-4-5",
    "max-budget-usd": 10.0
  }
}
