[
  {
    "webhook": "Default",
    "with-envs": [
      {
        "name": "GITHUB-TOKEN",
        "value": "secrets.GITHUB-TOKEN",
        "mandatory": false
      },
      {
        "name": "OPENAI-API-KEY",
        "value": "secrets.OPENAI-API-KEY",
        "mandatory": false
      }
    ],
    "executions": [
      {
        "name": "github-pr-review-with-plugin-adapter",
        "platform": "github",
        "repository": {
          "url": "repository.clone_url"
        },
        "match-any": [
          {
            "name": "github-pr-tag-adapter",
            "rule": "action==labeled&&label.name=='ai-dlc/pr/pr-review'&&pull_request.state=='open'"
          },
          {
            "name": "github-pr-opened-adapter",
            "rule": "action==opened&&pull_request.labels.*.name=='ai-dlc/pr/pr-review'&&pull_request.state=='open'"
          },
          {
            "name": "github-pr-synchronize-adapter",
            "rule": "action==synchronize&&pull_request.labels.*.name=='ai-dlc/pr/pr-review'&&pull_request.state=='open'"
          }
        ],
        "use-inputs": [
          {
            "name": "pr-number",
            "value": "pull_request.number",
            "mandatory": true
          }
        ],
        "use-plugins": [
          {
            "plugin-name": "pr-reviewer@xianix-plugins-official",
            "marketplace": "xianix-team/plugins-official"
          }
        ],
        "with-envs": [
          {
            "name": "GITHUB-TOKEN",
            "value": "secrets.GITHUB-TOKEN",
            "mandatory": true
          }
        ],
        "conversation-key": "pull_request.number",
        "model": "openai/gpt-5.3-codex",
        "max-budget-usd": 3,
        "execute-prompt": "You are reviewing pull request #{{pr-number}} in the repository {{repository-name}}. Run /pr-review {{pr-number}} to perform the automated review."
      },
      {
        "name": "github-pr-review-plain-opencode",
        "platform": "github",
        "repository": {
          "url": "repository.clone_url"
        },
        "match-any": [
          {
            "name": "github-pr-tag-plain",
            "rule": "action==labeled&&label.name=='ai-dlc/pr/opencode-plain'&&pull_request.state=='open'"
          },
          {
            "name": "github-pr-opened-plain",
            "rule": "action==opened&&pull_request.labels.*.name=='ai-dlc/pr/opencode-plain'&&pull_request.state=='open'"
          },
          {
            "name": "github-pr-synchronize-plain",
            "rule": "action==synchronize&&pull_request.labels.*.name=='ai-dlc/pr/opencode-plain'&&pull_request.state=='open'"
          }
        ],
        "use-inputs": [
          {
            "name": "pr-number",
            "value": "pull_request.number",
            "mandatory": true
          }
        ],
        "with-envs": [
          {
            "name": "GITHUB-TOKEN",
            "value": "secrets.GITHUB-TOKEN",
            "mandatory": true
          }
        ],
        "conversation-key": "pull_request.number",
        "model": "openai/gpt-5.3-codex",
        "max-budget-usd": 3,
        "execute-prompt": "PLAIN OPENCODE MODE — no plugin adapter, no recipes.\n\nReview PR #{{pr-number}} in {{repository-name}}.\n\nHARD RULES (must obey):\n1. Do NOT read or follow /workspace/recipes/**, /workspace/vendor/plugins/**, or any /pr-review command.\n2. Do NOT run recipes/scripts/*.sh or plugin scripts.\n3. Use only: `gh pr view`, `gh pr diff`, `gh api`, and `gh pr comment`.\n4. Post exactly ONE PR comment whose first line is:\n   `<!-- xianix-opencode-plain -->`\n5. After that marker, write a short plain-language review (findings + verdict). Keep it under 25 lines.\n6. Do NOT use pr-reviewer HTML markers (no `pr-reviewer:v1.2`), do NOT post inline review threads.\n\nIf you cannot review, still post one comment starting with `<!-- xianix-opencode-plain -->` explaining why."
      }
    ]
  },
  {
    "chat": "chat",
    "model": "openai/gpt-5.3-codex",
    "max-budget-usd": 5,
    "use-plugins": [
      {
        "plugin-name": "pr-reviewer@xianix-plugins-official",
        "marketplace": "xianix-team/plugins-official",
        "slash-command": "/pr-review"
      }
    ]
  }
]
