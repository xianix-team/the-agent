# Copy to tests/e2e/.env (gitignored) and fill in your values.

# The webhook endpoint for your deployed agent, from Xians Studio.
# Quote-free; keep the whole query string.
WEBHOOK_URL=http://localhost:5005/api/user/webhooks/builtin?apikeyId=...&timeoutSeconds=30&agentName=Xianix%20AI-DLC%20Agent&workflowName=Integrator%20Workflow&webhookName=Default&activationName=Xianix%20AI-DLC%20Agent

# Port the harness serves the fixture git repo on (git daemon). Change if taken.
FIXTURE_PORT=9418

# Hostname the executor CONTAINER uses to reach this machine.
# Docker Desktop (macOS/Windows): host.docker.internal. Linux: your host IP.
FIXTURE_HOST=host.docker.internal
